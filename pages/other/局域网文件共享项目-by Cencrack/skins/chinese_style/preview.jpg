<svg width="400" height="300" xmlns="http://www.w3.org/2000/svg">
  <!-- 背景渐变 -->
  <defs>
    <linearGradient id="bgGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0a0f1e"/>
      <stop offset="100%" stop-color="#1a2440"/>
    </linearGradient>
    <linearGradient id="primaryGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#3b82f6"/>
      <stop offset="100%" stop-color="#0069c0"/>
    </linearGradient>
    <!-- 中国风花纹 -->
    <pattern id="chinesePattern" width="50" height="50" patternUnits="userSpaceOnUse">
      <path d="M25 0 L50 25 L25 50 L0 25 Z" fill="none" stroke="#ffd700" stroke-width="1" opacity="0.1"/>
      <circle cx="25" cy="25" r="10" fill="none" stroke="#ffd700" stroke-width="1" opacity="0.1"/>
    </pattern>
  </defs>
  
  <!-- 主背景 -->
  <rect width="400" height="300" fill="url(#bgGradient)"/>
  <rect width="400" height="300" fill="url(#chinesePattern)"/>
  
  <!-- 科技感网格 -->
  <g opacity="0.1">
    <path d="M0 50 H400" stroke="#3b82f6" stroke-width="1"/>
    <path d="M0 150 H400" stroke="#3b82f6" stroke-width="1"/>
    <path d="M0 250 H400" stroke="#3b82f6" stroke-width="1"/>
    <path d="M100 0 V300" stroke="#3b82f6" stroke-width="1"/>
    <path d="M200 0 V300" stroke="#3b82f6" stroke-width="1"/>
    <path d="M300 0 V300" stroke="#3b82f6" stroke-width="1"/>
  </g>
  
  <!-- 中国风装饰元素 - 右上角 -->
  <path d="M350 0 L400 0 L400 50 C375 25 350 0 350 0 Z" fill="#ffd700" opacity="0.2"/>
  <path d="M350 0 L400 0 L400 50 C375 25 350 0 350 0 Z" fill="none" stroke="#ffd700" stroke-width="2"/>
  
  <!-- 中国风装饰元素 - 左下角 -->
  <path d="M0 250 L0 300 L50 300 C25 275 0 250 0 250 Z" fill="#ffd700" opacity="0.2"/>
  <path d="M0 250 L0 300 L50 300 C25 275 0 250 0 250 Z" fill="none" stroke="#ffd700" stroke-width="2"/>
  
  <!-- 主标题 -->
  <text x="200" y="80" font-family="SimSun, serif" font-size="30" fill="#f8fafc" text-anchor="middle" font-weight="bold">中国风科技风格</text>
  
  <!-- 副标题 -->
  <text x="200" y="110" font-family="SimSun, serif" font-size="16" fill="#94a3b8" text-anchor="middle">传统元素 × 现代科技</text>
  
  <!-- 装饰按钮 -->
  <rect x="120" y="140" width="160" height="40" rx="4" fill="url(#primaryGradient)"/>
  <rect x="120" y="140" width="160" height="40" rx="4" fill="none" stroke="#3b82f6" stroke-width="1"/>
  <text x="200" y="165" font-family="SimHei, sans-serif" font-size="16" fill="#f8fafc" text-anchor="middle">科技按钮</text>
  
  <!-- 装饰卡片 -->
  <rect x="50" y="190" width="300" height="80" rx="4" fill="#1a2440"/>
  <rect x="50" y="190" width="300" height="3" rx="1" fill="#ffd700"/>
  <rect x="50" y="190" width="300" height="80" rx="4" fill="none" stroke="#3a5080" stroke-width="1"/>
  <text x="200" y="220" font-family="SimHei, sans-serif" font-size="14" fill="#f8fafc" text-anchor="middle">中国风科技卡片设计</text>
  <text x="200" y="245" font-family="SimHei, sans-serif" font-size="12" fill="#94a3b8" text-anchor="middle">融合传统与现代的视觉体验</text>
  
  <!-- 底部装饰线 -->
  <line x1="100" y1="285" x2="300" y2="285" stroke="#3b82f6" stroke-width="1" opacity="0.5"/>
  <circle cx="200" cy="285" r="3" fill="#ffd700"/>
</svg>