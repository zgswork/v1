# 启用URL重写引擎
RewriteEngine On

# 禁止直接访问数据库文件（通过Web浏览器）
<Files "*.db">
    Order allow,deny
    Deny from all
</Files>

# 允许PHP脚本访问admin.db，但禁止直接Web访问
<Files "admin.db">
    # 只允许本地服务器访问，禁止外部直接访问
    Order allow,deny
    Allow from 127.0.0.1
    Allow from localhost
    Allow from server
    Deny from all
    
    # 允许PHP脚本访问
    <IfModule mod_php7.c>
        Order allow,deny
        Allow from all
    </IfModule>
    
    <IfModule mod_php.c>
        Order allow,deny
        Allow from all
    </IfModule>
</Files>

# 禁止访问配置文件
<Files "*.ini">
    Order allow,deny
    Deny from all
</Files>

<Files "*.config">
    Order allow,deny
    Deny from all
</Files>

# 禁止访问PHP配置文件
<Files "db_config.php">
    Order allow,deny
    Deny from all
</Files>

# 禁止访问安全相关文件
<Files "security_utils.php">
    Order allow,deny
    Deny from all
</Files>

<Files "file_security_checker.php">
    Order allow,deny
    Deny from all
</Files>

# 禁止访问白名单文件
<Files "file_whitelist.php">
    Order allow,deny
    Deny from all
</Files>

# 禁止目录列表
Options -Indexes

# 防止访问隐藏文件
<Files ~ "^\.">
    Order allow,deny
    Deny from all
</Files>

# 禁止访问备份文件
<Files ~ "\.(bak|backup|old|tmp|log)$">
    Order allow,deny
    Deny from all
</Files>

# 将敏感文件请求重定向到保护脚本
RewriteCond %{REQUEST_FILENAME} \.(db|ini|config|log|bak|backup|old|tmp)$ [NC]
RewriteRule ^(.*)$ protect_files.php [L]

# 特别处理admin.db文件
RewriteCond %{REQUEST_FILENAME} admin\.db$ [NC]
RewriteRule ^(.*)$ admin.db.php [L]

RewriteCond %{REQUEST_FILENAME} ^(db_config|security_utils|file_security_checker|file_whitelist|check_server_env)\.php$ [NC]
RewriteRule ^(.*)$ protect_files.php [L]