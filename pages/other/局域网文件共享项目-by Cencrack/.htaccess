# 禁止直接访问数据库文件
<Files "*.db">
    Order allow,deny
    Deny from all
</Files>

# 禁止直接访问特定文件
<Files "admin.db">
    Order allow,deny
    Deny from all
</Files>

# 禁止访问配置文件
<Files "*.ini">
    Order allow,deny
    Deny from all
</Files>

<Files "*.config">
    Order allow,deny
    Deny from all
</Files>

# 禁止访问PHP配置文件
<Files "db_config.php">
    Order allow,deny
    Deny from all
</Files>

# 防止访问隐藏文件
<Files ~ "^\.">
    Order allow,deny
    Deny from all
</Files>

# 禁止访问备份文件
<Files ~ "\.(bak|backup|old|tmp|log)$">
    Order allow,deny
    Deny from all
</Files>

# 禁止目录列表
Options -Indexes